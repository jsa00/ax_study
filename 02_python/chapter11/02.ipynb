   "source": [
    "# 11장 2강 : 코루틴(Coroutine)과 async / await\n",
    "1. 코루틴과 일반 함수의 작동 방식 차이\n",
    "2. 실행 환경에 따른 가동 방식"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c9620cc2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 실행 환경에 따른 가동 방식\n",
    "# 동기식\n",
    "import asyncio\n",
    "\n",
    "async def work():\n",
    "    await asyncio.sleep(2)\n",
    "    print(\"작업 완료\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "b5549a7b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "작업 완료\n"
     ]
    }
   ],
   "source": [
    "await work()"
   ]
  }
 ],
